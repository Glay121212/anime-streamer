{
  "name": "anime-streamer",
  "version": "1.0.0",
  "main": "electron.js",
  "description": "Search movies, TV shows, and anime across 15 streaming sites. Launch videos in VLC or MPV.",
  "author": "Anime Streamer",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev",
    "test": "npx jest --detectOpenHandles"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.animestreamer.app",
    "productName": "Anime Streamer",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "electron.js",
      "preload.js",
      "src/**/*",
      "services/**/*",
      "config/**/*",
      "bin/**/*",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "bin/yt-dlp.exe",
        "to": "bin/yt-dlp.exe"
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
